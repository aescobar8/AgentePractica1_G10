# Configuración de PostgreSQL (usar valores propios en mcp_server/.env)
POSTGRES_HOST=tu_host_postgresql
POSTGRES_PORT=5432
POSTGRES_DB=tu_base_de_datos
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contrasena
POSTGRES_SSLMODE=require

# Configuración opcional de Google Gemini
GOOGLE_API_KEY=tu_clave_de_google_ai_studio
GOOGLE_MODEL=gemini-flash-latest
